<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rad_costmap_plugin</name>
  <version>1.0.0</version>
  <description>A Nav2 costmap layer to represent radiation sources.</description>
  <maintainer email="hello@turingnet.work">Brendon Cintas</maintainer>
  <license>ISC</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap plugin="${prefix}/plugins.xml" />
  </export>
</package>
