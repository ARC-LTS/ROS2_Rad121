<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rad_launch</name>
  <version>1.0.0</version>
  <description>Staged launch entry points for the RaMonES radiation-aware exploration stack (Gazebo, radiation simulation, SLAM, Nav2, exploration, recovery, safety and GP heatmapping), plus the system reset node.</description>
  <maintainer email="hello@turingnet.work">Brendon Cintas</maintainer>
  <license>BSD-3-Clause</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <depend>rad121_monitor</depend>
  <depend>ros2_rad_map</depend>
  <depend>rad_simulation</depend>
  <depend>rad_local_recovery</depend>
  <depend>explore_lite</depend>
  <exec_depend>rad_safety</exec_depend>
  <exec_depend>rad_nav_behavior</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- rad_spot_launch.py additionally needs spot_robot (Spot hardware bringup,
       not in this workspace). It is intentionally not declared so rosdep and
       colcon work without the Spot stack installed. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
